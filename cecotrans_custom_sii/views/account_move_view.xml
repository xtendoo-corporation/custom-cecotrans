<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_out_invoice_tree_aeat_state_cecotrans" model="ir.ui.view">
        <field name="name">account.move.out.invoice.tree.aeat.state.cecotrans</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field
                    name="aeat_state"
                    string="Estado de envío SII"
                    widget="badge"
                    decoration-info="aeat_state == 'not_sent'"
                    decoration-danger="aeat_state == 'sent_w_errors'"
                    decoration-warning="aeat_state in ('sent_modified', 'cancelled_modified')"
                    decoration-success="aeat_state in ('sent', 'cancelled')"
                    optional="show"
                />
            </field>
        </field>
    </record>

