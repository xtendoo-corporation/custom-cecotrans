<?xml version="1.0"?>
<odoo>
    <data>
        <template
            id="document_format_cecotrans.report_invoice_document_cecotrans"
            inherit_id="account.report_invoice_document"
        >

            <xpath expr="//div[hasclass('page')]" position="inside">
                <t t-set="partner_id" t-value="o.partner_id" />
            </xpath>

            <!-- Reemplazar todo el bloque de direcciones del cliente que aparece duplicado -->
            <xpath expr="//t[@t-call='web.external_layout']/div[@class='row'][1]" position="replace">
            </xpath>

            <xpath expr="//div[@name='customer_code']" position="attributes">
                <attribute name="style">display: none;</attribute>
            </xpath>

            <!-- Ocultar también el div con name='reference' si existe -->
            <!-- <xpath expr="//div[@name='reference']" position="attributes">
                <attribute name="style">display: none;</attribute>
            </xpath> -->

            <xpath expr="//p[@name='payment_communication']" position="replace">
                <p style="margin-top:40px;"
                    t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference"
                    name="payment_communication"> Por favor utilice la siguiente referencia al
                    realizar su pago: <b>
                        <span t-field="o.payment_reference" />
                    </b>
                </p>
            </xpath>

            <!-- Reemplazar header DESCRIPCIÓN -->
            <xpath expr="//th[@name='th_description']" position="replace">
                <th name="th_description">
                    <span>DESCRIPCIÓN</span>
                </th>
            </xpath>

            <!-- Reemplazar header CANTIDAD -->
            <xpath expr="//th[@name='th_quantity']" position="replace">
                <th name="th_quantity" class="text-right">
                    <span>CANTIDAD</span>
                </th>
            </xpath>

            <!-- Reemplazar header PRECIO -->
            <xpath expr="//th[@name='th_priceunit']" position="replace">
                <th name="th_priceunit" class="text-right">
                    <span>PRECIO</span>
                </th>
            </xpath>


            <xpath expr="//th[@name='th_taxes']" position="replace">
                <th name="th_taxes" class="text-right">
                    <span>IMPUESTOS</span>
                </th>
            </xpath>


            <xpath expr="//th[@name='th_subtotal']" position="replace">
                <th name="th_subtotal" class="text-right">
                    <span>IMPORTE</span>
                </th>
            </xpath>

            <xpath expr="//tbody[@class='invoice_tbody']" position="replace">
                <style>
                    .invoice_tbody td {
                    padding-top: 1px !important;
                    padding-bottom: 1px !important;
                    vertical-align: middle !important;
                    }
                </style>
                <tbody class="invoice_tbody">
                    <t t-set="current_subtotal" t-value="0" />
                    <t t-set="lines"
                        t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)" />

                    <t t-foreach="lines" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                            groups="account.group_show_line_subtotals_tax_excluded" />
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                            groups="account.group_show_line_subtotals_tax_included" />

                        <tr
                            t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type or line.display_type == 'product'"
                                name="account_invoice_line_accountable">
                                <td name="account_invoice_line_name">
                                    <t t-if="line.name">
                                        <t t-set="productName" t-value="line.name" />
                                        <t t-set="name_num" t-value="productName.find(']') + 1 " />
                                        <t t-set="name" t-value="productName[name_num:]" />
                                        <span t-esc="name" t-options="{'widget': 'text'}" />
                                    </t>
                                    <t t-else="">
                                        <span t-field="line.product_id.name"></span>
                                    </t>
                                </td>
                                <td class="text-right">
                                    <span t-field="line.quantity" />
                                    <span t-field="line.product_uom_id" groups="uom.group_uom" />
                                </td>
                                <td class="text-right">
                                    <span class="text-nowrap" t-field="line.price_unit" />
                                </td>
                                <td class="text-right" t-if="display_discount">
                                    <span class="text-nowrap" t-field="line.discount" />
                                </td>
                                <t t-set="line_tax_amount"
                                    t-value="line.price_total - line.price_subtotal" />
                                <td class="text-right">
                                    <span t-esc="line_tax_amount" id="line_tax_ids"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" />
                                </td>
                                <td class="text-right o_price_total">
                                    <span class="text-nowrap" t-field="line.price_subtotal" />
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}" />
                                </td>
                                <t t-set="current_section" t-value="line" />
                                <t t-set="current_subtotal" t-value="0" />
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}" />
                                </td>
                            </t>
                        </tr>

                        <t
                            t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-right">
                                <td colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-esc="current_subtotal"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" />
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </xpath>

            <xpath expr="//p[@name='payment_communication']" position="before">
                <span style="display:block;">Forma de pago: transferencia</span>
                <span style="display:block;">Banco: BANKINTER</span>
                <span style="display:block;">IBAN: ES93 0128 6701 22 0100006797</span>
            </xpath>

        </template>
    </data>
</odoo>